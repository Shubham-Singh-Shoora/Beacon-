{
  "name": "@hammerock/cca-widget",
  "version": "0.2.0",
  "description": "Embeddable React component (and <script> tag) showing a live Uniswap CCA auction with a bid form. Ethereum, Base, Unichain, Arbitrum and their testnets.",
  "keywords": [
    "uniswap",
    "cca",
    "continuous-clearing-auction",
    "auction",
    "widget",
    "react",
    "embed",
    "viem"
  ],
  "license": "MIT",
  "author": "Shubham Singh Shoora",
  "homepage": "https://github.com/Shubham-Singh-Shoora/Beacon-/tree/master/packages/widget#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shubham-Singh-Shoora/Beacon-.git",
    "directory": "packages/widget"
  },
  "bugs": {
    "url": "https://github.com/Shubham-Singh-Shoora/Beacon-/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mount": "./src/mount.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./mount": "./dist/mount.global.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@hammerock/cca-sdk": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "viem": "^2.40.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "viem": "^2.40.0",
    "wagmi": "^2.19.0",
    "@tanstack/react-query": "^5.90.0"
  }
}
