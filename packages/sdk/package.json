{
  "name": "@hammerock/cca-sdk",
  "version": "0.3.0",
  "description": "TypeScript SDK for Uniswap Continuous Clearing Auctions (CCA): discovery across every factory version, live state, Q96 math and bid construction. Ethereum, Base, Unichain, Arbitrum and their testnets.",
  "keywords": [
    "uniswap",
    "cca",
    "continuous-clearing-auction",
    "token-launch",
    "auction",
    "viem",
    "ethereum",
    "sdk"
  ],
  "license": "MIT",
  "author": "Shubham Singh Shoora",
  "homepage": "https://github.com/Shubham-Singh-Shoora/Beacon-/tree/master/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shubham-Singh-Shoora/Beacon-.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/Shubham-Singh-Shoora/Beacon-/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./node": {
        "import": {
          "types": "./dist/node.d.ts",
          "default": "./dist/node.js"
        },
        "require": {
          "types": "./dist/node.d.cts",
          "default": "./dist/node.cjs"
        }
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:live": "tsx test/live-check.ts",
    "sync": "tsx test/sync-cli.ts",
    "deploy:demo": "tsx scripts/deploy-demo-auction.ts",
    "prepublishOnly": "tsup"
  },
  "peerDependencies": {
    "viem": "^2.40.0"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "viem": "^2.40.0",
    "vitest": "^3.2.4"
  }
}
