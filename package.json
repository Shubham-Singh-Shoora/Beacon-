{
  "name": "beacon",
  "version": "0.1.0",
  "private": true,
  "description": "Beacon — developer tooling for Uniswap's Continuous Clearing Auction (CCA) protocol",
  "license": "MIT",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "web": "pnpm --filter @beacon/web dev",
    "bot": "pnpm --filter @beacon/telegram-bot dev",
    "agent": "pnpm --filter @beacon/bidding-agent dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
