{
  "name": "beacon",
  "version": "0.1.0",
  "private": true,
  "description": "Beacon \u2014 developer tooling for Uniswap's Continuous Clearing Auction (CCA) protocol",
  "license": "MIT",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter @hammerock/cca-agent build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "web": "pnpm --filter @beacon/web dev",
    "bot": "pnpm --filter @beacon/telegram-bot dev",
    "bot:start": "pnpm --filter @beacon/telegram-bot start",
    "bot:smoke": "pnpm --filter @beacon/telegram-bot smoke",
    "bot:check": "pnpm --filter @beacon/telegram-bot check",
    "agent": "pnpm --filter @hammerock/cca-agent cli --env ../../.env",
    "sync:auctions": "pnpm --filter @hammerock/cca-sdk sync",
    "demo:embed": "pnpm --filter @hammerock/cca-widget build && node -e \"require('fs').copyFileSync('packages/widget/dist/mount.global.js','apps/web/public/beacon-widget.js')\"",
    "deploy:demo": "pnpm --filter @hammerock/cca-sdk deploy:demo"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
