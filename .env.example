# ---------------------------------------------------------------------------
# Beacon - environment template.
# Copy to `.env` (gitignored) and fill in. Never commit a real key.
# Mainnets (1, 8453, 130, 42161) and testnets (11155111, 84532, 1301) are
# supported. Reading is safe anywhere; the bidding agent only broadcasts on a
# mainnet with --mainnet / AGENT_ALLOW_MAINNET=true.
# ---------------------------------------------------------------------------

# --- RPC (shared by SDK, web, bot, sync) -------------------------------------
# Every chain has a FREE default endpoint built in (packages/sdk/src/networks.ts),
# with its measured eth_getLogs limits. Nothing here is required.
#
# Per-chain overrides - the number is the chain id. SERVER SIDE ONLY: a keyed
# URL must never go in a NEXT_PUBLIC_ variable.
#   BEACON_RPC_URL_<id>            replace the free default
#   BEACON_FALLBACK_RPC_URL_<id>   tried when the primary errors (comma-separated)
#   BEACON_LOGS_RPC_URL_<id>       eth_getLogs only
BEACON_FALLBACK_RPC_URL_1=
BEACON_FALLBACK_RPC_URL_8453=
BEACON_FALLBACK_RPC_URL_130=
BEACON_FALLBACK_RPC_URL_42161=

# The single chain the CLI tools (agent, status scripts) default to. The
# unsuffixed BEACON_RPC_URL / BEACON_LOGS_RPC_URL apply to this chain only.
BEACON_CHAIN_ID=11155111
BEACON_RPC_URL=

# Auction stores live in data/auctions.<chain>.json, one per chain, written by
# `pnpm sync:auctions -- --chain <slug|mainnets|all>`.

# --- CCA contracts -----------------------------------------------------------
# Factory addresses (v2.1.0, v2.0.0 and the deprecated v1.1.0) and the block
# each was deployed at on every chain are built into the SDK - nothing to set.
# See packages/sdk/src/constants.ts and the README.
#
# Optional: a deployed AuctionStateLens. Leave blank - the SDK runs the lens
# inside eth_call via a state override, so no deployment is needed.
BEACON_LENS_ADDRESS=

# Max block span per eth_getLogs call. Public Sepolia RPCs reject spans >50000.
BEACON_LOG_CHUNK_SIZE=50000

# --- Indexer / storage ------------------------------------------------------
# SQLite file written by the auction discovery poller.
BEACON_DB_PATH=./data/beacon.db
# Seconds between discovery/state polls.
BEACON_POLL_INTERVAL_SECONDS=15

# --- apps/web -------------------------------------------------------------
# Chains the directory lists (slugs, comma-separated). Default: the four
# mainnets plus Sepolia.
BEACON_CHAINS=
# The chain the directory opens on. Default: base.
BEACON_DEFAULT_CHAIN=

# --- apps/telegram-bot ------------------------------------------------------
# Chains one bot process watches (slugs). Default: four mainnets plus Sepolia.
BEACON_BOT_CHAINS=
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Channel or DM to post alerts into (e.g. -1001234567890 or a numeric user id)
TELEGRAM_CHAT_ID=
# DEV/TESTING FALLBACK ONLY. Seeds TELEGRAM_CHAT_ID's subscriptions at startup.
# The real UX is the /watch <address> command in Telegram, which is per chat and
# persists to BEACON_SUBSCRIPTIONS_PATH. Leave blank for normal use.
# Beacon's own demo auction on Sepolia:
#   BEACON_WATCH_AUCTION_ADDRESS=0x1e40451D6ecabA8640559b7dFbe63B41dA52460d
BEACON_WATCH_AUCTION_ADDRESS=
# Where per-chat /watch registrations are stored.
BEACON_SUBSCRIPTIONS_PATH=data/telegram-subscriptions.json

# Alert thresholds. Prices are human decimals, converted to Q96 by the SDK.
# Blank disables that rule.
BEACON_ALERT_PRICE_ABOVE=
BEACON_ALERT_PRICE_BELOW=
BEACON_ALERT_MINUTES_LEFT=15

# --- apps/bidding-agent -----------------------------------------------------
# Only needed for `cca-agent run --live` / `settle --live`. Use a dedicated wallet
# holding no more than your budget plus gas. Never commit it.
# Read from the environment only, never logged - the agent prints the derived
# address and nothing else. Accepted with or without the 0x prefix.
# Leave blank to run dry-run/simulate/plan modes.
AGENT_PRIVATE_KEY=

# Funded TESTNET key used only by `pnpm deploy:demo`. Same rules as above.
DEPLOYER_PRIVATE_KEY=
# Beacon's own demo auction on Sepolia.
AGENT_AUCTION_ADDRESS=0x1e40451D6ecabA8640559b7dFbe63B41dA52460d
# Human-readable price cap the agent will never bid above.
AGENT_MAX_PRICE=0.0001
# Hard safety cap on total spend across the agent's whole run, in wei.
AGENT_MAX_SPEND_WEI=10000000000000000
# Bid size per submission, in wei.
AGENT_BID_AMOUNT_WEI=1000000000000000
# Bid up when the clearing price comes within this % of AGENT_MAX_PRICE.
AGENT_TRIGGER_PERCENT=10
# Stop after this many bids, regardless of budget.
AGENT_MAX_BIDS=3
# Set to "true" to actually broadcast. Anything else = dry run (logs only).
# `--dry-run` on the command line always overrides this.
AGENT_BROADCAST=false
