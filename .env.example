# ---------------------------------------------------------------------------
# Beacon - environment template.
# Copy to `.env` (gitignored) and fill in. Never commit a real key.
# TESTNET ONLY. Every app in this repo refuses to run against mainnet.
# ---------------------------------------------------------------------------

# --- Chain / RPC (shared by SDK, web, bot, agent) --------------------------
# Target network: Ethereum Sepolia. Verified live - see README.
BEACON_CHAIN_ID=11155111

# State reads (eth_call, multicall). A keyed provider such as Alchemy is ideal
# here. SERVER SIDE ONLY - never copy a keyed URL into a NEXT_PUBLIC_ variable.
BEACON_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Log scanning (eth_getLogs) for auction discovery. This needs a provider that
# allows WIDE block ranges - Alchemy's free tier caps eth_getLogs at 10 blocks,
# which makes a 1.5M-block backfill impossible. Defaults to BEACON_RPC_URL.
BEACON_LOGS_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Where discovered auctions are cached, relative to the repo root.
BEACON_STORE_PATH=data/auctions.sepolia.json

# --- CCA contract addresses (verified on Sepolia, see README) --------------
# ContinuousClearingAuctionFactory v1.1.0 - emits the AuctionCreated event.
# VERIFIED: the deployed runtime bytecode is byte-for-byte identical to a local
# build of upstream tag v1.1.0 (commit a0aabaa). The address is identical on
# every chain because it was deployed via the CREATE2 deployer 0x4e59b448...
BEACON_FACTORY_ADDRESS=0xCCccCcCAE7503Cac057829BF2811De42E16e0bD5
# Factory creation block on Sepolia (2026-01-26). Directory scanning starts here.
BEACON_FACTORY_DEPLOY_BLOCK=10130119
# AuctionStateLens - we deploy our own in Phase 1. There is NO canonical CCALens
# address published anywhere, and CCALens only exists upstream from v2.x, whose
# TickDataLens half is NOT compatible with the v1.1.0 auctions this factory
# creates (it calls remainingSupplyQ96X7, which does not exist in v1.1.0).
BEACON_LENS_ADDRESS=

# Max block span per eth_getLogs call. Public Sepolia RPCs reject spans >50000.
BEACON_LOG_CHUNK_SIZE=50000

# --- Indexer / storage ------------------------------------------------------
# SQLite file written by the auction discovery poller.
BEACON_DB_PATH=./data/beacon.db
# Seconds between discovery/state polls.
BEACON_POLL_INTERVAL_SECONDS=15

# --- apps/web (Next.js - NEXT_PUBLIC_* is exposed to the browser) ----------
NEXT_PUBLIC_BEACON_CHAIN_ID=11155111
# PUBLIC endpoint only. This one reaches the visitor's browser via the embedded
# widget, so it must never carry an API key. The directory itself reads through
# the server, not this.
NEXT_PUBLIC_BEACON_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_BEACON_FACTORY_ADDRESS=0xCCccCcCAE7503Cac057829BF2811De42E16e0bD5
NEXT_PUBLIC_BEACON_LENS_ADDRESS=
# WalletConnect Cloud project id - needed by the widget's bid form
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- apps/telegram-bot ------------------------------------------------------
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Channel or DM to post alerts into (e.g. -1001234567890 or a numeric user id)
TELEGRAM_CHAT_ID=
# Auction(s) to watch, comma separated. LEAVE BLANK to have the bot discover
# auctions from the factory and auto-select (live first, then pending, then the
# most recently created). No placeholder address needed.
BEACON_WATCH_AUCTION_ADDRESS=
# How many auctions to auto-select when the list above is blank.
BEACON_AUTO_SELECT_LIMIT=5

# Alert thresholds. Prices are human decimals, converted to Q96 by the SDK.
# Blank disables that rule.
BEACON_ALERT_PRICE_ABOVE=
BEACON_ALERT_PRICE_BELOW=
BEACON_ALERT_MINUTES_LEFT=15

# --- apps/bidding-agent -----------------------------------------------------
# TESTNET KEY ONLY. Use a throwaway wallet. Never a mainnet key. Never commit.
AGENT_PRIVATE_KEY=
AGENT_AUCTION_ADDRESS=
# Human-readable price cap the agent will never bid above.
AGENT_MAX_PRICE=0.0001
# Hard safety cap on total spend across the agent's whole run, in wei.
AGENT_MAX_SPEND_WEI=10000000000000000
# Bid size per submission, in wei.
AGENT_BID_AMOUNT_WEI=1000000000000000
# Bid up when the clearing price comes within this % of AGENT_MAX_PRICE.
AGENT_TRIGGER_PERCENT=10
# Set to "true" to actually broadcast. Anything else = dry run (logs only).
AGENT_BROADCAST=false
