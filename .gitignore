# dependencies
node_modules/
.pnpm-store/

# build output
dist/
.next/
out/
*.tsbuildinfo

# environment — NEVER commit a real key, testnet or otherwise
.env
.env.*
!.env.example

# local data
*.db
*.db-journal
*.sqlite
# Ignore the contents, not the directory itself - git will not descend into an
# ignored directory, so a `!` negation below it would never match.
data/*
# ...but the discovered-auction store IS committed: rebuilding it needs many
# scans against an unreliable public RPC, so shipping it makes the directory
# reproducible for anyone cloning the repo.
!data/auctions.sepolia.json

# Built widget bundle copied into the web app's public dir by `pnpm demo:embed`.
apps/web/public/beacon-widget.js

# editor / OS
.DS_Store
.vscode/
.idea/

# misc
coverage/
.vercel/
