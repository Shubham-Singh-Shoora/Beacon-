# dependencies
node_modules/
.pnpm-store/

# build output
dist/
# Foundry artifacts for the demo token (regenerate with ./contracts/build-demo.sh)
contracts/demo/out/
contracts/demo/cache/
.next/
out/
*.tsbuildinfo

# environment — NEVER commit a real key, testnet or otherwise
.env
.env.*
!.env.example

# local data
*.db
*.db-journal
*.sqlite
# Ignore the contents, not the directory itself - git will not descend into an
# ignored directory, so a `!` negation below it would never match.
data/*
# ...but the discovered-auction stores ARE committed (one per chain): rebuilding
# them needs a long history scan, and the deployed directory reads them.
!data/auctions.*.json

# Built widget bundle copied into the web app's public dir by `pnpm demo:embed`.
apps/web/public/beacon-widget.js

# editor / OS
.DS_Store
.vscode/
.idea/

# misc
coverage/
.vercel/
